# Server-only secrets. Never commit the real file.
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# TiDB Cloud (use the values from TiDB Connect, not the frontend)
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=replace_me
TIDB_PASSWORD=replace_me
TIDB_DATABASE=sys
TIDB_CA_PATH=./CA.pem

# Cloudinary server-side URL. Keep this on the server only.
CLOUDINARY_URL=cloudinary://api_key:api_secret:cloud_name
